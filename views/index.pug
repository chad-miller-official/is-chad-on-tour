html
  head
    title='Chad is not on tour.'
    link(rel='stylesheet', type='text/css', href='/css/styles.css')
    script(src='/js/icot.js')
  body
    include includes/header.pug
    div(id='container')
      div(id='posts')
        div(id='postList')
          h2
            | The Latest &nbsp;
          a(href='/rss.xml')
            img(src='/img/rss.gif')
          ol(reversed)
            each post in posts
              li
                a(href='#' + post)=post
        div(id='postFrame')
          div(id='message')
            h1(class='verdict-no')='No'
            h2='Chad is not on tour.'
